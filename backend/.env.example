# Backend environment configuration for VPS deployment
# Copy this to .env and update values

# AI Mode Selection
# Options: ollama, openai, runpod
AI_MODE=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lentera-dreamflow
AI_MODE=ollama

# OpenAI Configuration (if using AI_MODE=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# Modal Configuration (if using AI_MODE=modal)
MODAL_ENDPOINT_URL=https://your-name--lentera-llama-generate.modal.run

# Server Configuration
HOST=0.0.0.0
PORT=8000
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# TTS Configuration
TTS_ENGINE=edge-tts
TTS_VOICE=id-ID-ArdiNeural

# Logging
LOG_LEVEL=INFO
DEBUG=False

# CORS (add your Flutter app domain)
ALLOWED_ORIGINS=http://localhost:*,https://yourdomain.com
