# LENTERA Backend Environment Variables

# AI Mode Selection
# Options: ollama, openai, runpod
AI_MODE=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# OpenAI Configuration (if using AI_MODE=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# RunPod Configuration (if using AI_MODE=runpod)
RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/{your-endpoint-id}/runsync
RUNPOD_API_KEY=your_runpod_api_key

# Whisper Configuration
WHISPER_MODEL=base
WHISPER_LANGUAGE=id

# TTS Configuration
TTS_MODEL=tts_models/multilingual/multi-dataset/your_tts
TTS_LANGUAGE=id

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Supabase (if using)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
