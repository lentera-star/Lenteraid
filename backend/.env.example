# Backend environment configuration for VPS deployment
# Copy this to .env and update values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=lentera-dreamflow
AI_MODE=ollama

# Server Configuration
HOST=0.0.0.0
PORT=8000

# OpenAI Configuration (fallback, optional)
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4

# Whisper Configuration (for audio)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# TTS Configuration
TTS_ENGINE=edge-tts
TTS_VOICE=id-ID-ArdiNeural

# Logging
LOG_LEVEL=INFO
DEBUG=False

# CORS (add your Flutter app domain)
ALLOWED_ORIGINS=http://localhost:*,https://yourdomain.com
