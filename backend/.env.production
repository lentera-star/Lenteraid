# Production Environment Configuration for VPS

# ========================================
# AI Configuration - OpenAI Fine-tuned Model
# ========================================
AI_MODE=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=ft:gpt-3.5-turbo-0125:personal:lentera-safety-v2:CtBTujc1

# Model Update Guide:
# Setelah fine-tuning baru selesai, ganti value OPENAI_MODEL di atas
# Format: ft:gpt-3.5-turbo-0125:personal:<model-name>:<model-id>
# Restart backend: systemctl restart lentera-backend

# ========================================
# Whisper Configuration (CPU Optimized)
# ========================================
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=id
WHISPER_MODEL_DIR=./models/whisper

# ========================================
# TTS Configuration - LOCAL (Fully Offline)
# ========================================
LOCAL_TTS_MODEL=nayerim/speecht5-indonesian-tts
TTS_DEVICE=cpu

# ========================================
# Audio Settings
# ========================================
MAX_AUDIO_LENGTH_SECONDS=300
AUDIO_SAMPLE_RATE=16000

# ========================================
# API Configuration
# ========================================
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# ========================================
# CORS Settings
# ========================================
CORS_ORIGINS=*

# ========================================
# Supabase (Optional - for future features)
# ========================================
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
